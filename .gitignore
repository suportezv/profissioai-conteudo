.env
.DS_Store
__pycache__/

# Mídia pesada dos projetos (brutos e renders ficam locais ou no Drive).
# As extensoes vao em maiuscula E minuscula: a camera Sony grava `.MP4` e o
# padrao minusculo deixava passar 742 MB de bruto sem ninguem notar.
projects/**/*.mp4
projects/**/*.MP4
projects/**/*.MP4.part
projects/**/*.mov
projects/**/*.wav
projects/**/*.m4a
projects/**/*.MOV
projects/**/*.png
projects/**/*.mp3
projects/**/*.aac

# Remotion
remotion/node_modules/
remotion/out/

# fundos de cena do kit de marca (baixar do Drive quando precisar)
marca/fundos/

# b-roll copiado de projects/ para o Remotion enxergar: mídia não vai para o git
remotion/public/broll/
remotion/public/soldiers/

# derivados reproduziveis: a LUT sai do gera_lut_slog2.py e a transcricao do
# Scribe. O que vale versionar e o edl.json, que e a decisao de corte.
projects/**/*.cube
projects/**/stt/

# Ativos do cliente e b-roll do case 04: repo publico, nada disso entra sem
# autorizacao explicita. Inclui a foto de pessoa real publicada pelo cliente.
remotion/public/soldiers-personas/
remotion/public/marca-soldiers/
remotion/public/soldiers-broll/
